      "AC1 sync completes",
      "AC2 retries are bounded",
      "AC3 failure alert fires once"
    ],
    "scope": [
      "sync job"
    ],
    "corrective_limit": 2,
    "review_limit": 2,
    "realign_after": 2,
    "circuit_break_after": 3
  },
  "events": [
