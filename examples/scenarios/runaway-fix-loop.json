    },
    {
      "kind": "activity",
      "what": "tests",
      "count": 40
    },
    {
      "kind": "corrective"
    },
    {
      "kind": "checkpoint",
      "note": "Retry with a longer timeout."
    },
    {
      "kind": "activity",
