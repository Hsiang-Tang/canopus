      "kind": "review"
    },
    {
      "kind": "corrective"
    },
    {
      "kind": "checkpoint",
      "note": "Try mocking the upstream service."
    },
    {
      "kind": "activity",
      "what": "commits",
      "count": 4
    },
    {
      "kind": "activity",
      "what": "tests",
      "count": 40
